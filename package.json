{
  "name": "path-header",
  "displayName": "Path Header",
  "description": "comments the file path at the very top of the file",
  "version": "0.1.0",
  "publisher": "Rose Waters",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "path-header.addFilePath",
        "title": "Path Header: Add File Path"
      },
      {
        "command": "path-header.toggleAutoInsert",
        "title": "Path Header: Toggle Automatic Insertion"
      }
    ],
    "configuration": {
      "title": "Path Header",
      "properties": {
        "pathHeader.autoInsert": {
          "type": "boolean",
          "default": true,
          "description": "Automatically add path headers to newly created files."
        },
        "pathHeader.pathStyle": {
          "type": "string",
          "enum": [
            "relative",
            "absolute"
          ],
          "enumDescriptions": [
            "Use paths relative to the workspace folder.",
            "Use the full file system path."
          ],
          "default": "relative",
          "description": "Choose how the file paths appear in headers."
        },
        "pathHeader.prefix": {
          "type": "string",
          "default": "",
          "description": "Text inserted before the file path inside the comment, for example 'File: '."
        },
        "pathHeader.languageRules": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "boolean"
          },
          "description": "Override header behavior for individual VS Code language IDs. Set a language to false to disable headers or true to enable them. Example: {\"typescript\": true, \"markdown\": false}."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
